<Window x:Class="ChronoMailBridge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ChronoMail Bridge" Height="820" Width="1220"
        MinHeight="700" MinWidth="1040" Background="#F4F7FB"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13.5" UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#172033"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#64748B"/>
        <SolidColorBrush x:Key="StrokeBrush" Color="#DDE4EE"/>
        <SolidColorBrush x:Key="StrokeStrongBrush" Color="#CBD5E1"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#0F9F79"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#D97706"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#DC2626"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="BaseButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="104"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#60A5FA"/>
                                <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.42"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource StrokeStrongBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="#FFF7F7"/>
            <Setter Property="BorderBrush" Value="#FECACA"/>
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
        </Style>
        <Style x:Key="HelpToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="7,0,0,0"/>
            <Setter Property="Background" Value="#EFF6FF"/>
            <Setter Property="BorderBrush" Value="#BFDBFE"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="HelpBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HelpBorder" Property="Background" Value="#DBEAFE"/>
                                <Setter TargetName="HelpBorder" Property="BorderBrush" Value="#93C5FD"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="HelpBorder" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="HelpBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="HelpBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,4,0,13"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource StrokeStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="InputBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="InputBorder" Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,4,0,13"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource StrokeStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="InputBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,2,0,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border x:Name="CheckBorder" Width="18" Height="18" Margin="0,0,9,0"
                                    VerticalAlignment="Center" Background="White"
                                    BorderBrush="{StaticResource StrokeStrongBrush}" BorderThickness="1" CornerRadius="4">
                                <Path x:Name="CheckMark" Width="10" Height="8" Data="M 1 4 L 4 7 L 9 1"
                                      Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBorder" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <ContentPresenter Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <Border x:Name="Track" Width="42" Height="24" Padding="3" Background="#CBD5E1" CornerRadius="12">
                                <Ellipse x:Name="Thumb" Width="18" Height="18" HorizontalAlignment="Left" Fill="White"/>
                            </Border>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource SuccessBrush}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="Opacity" Value="0.86"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,4,0,13"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource StrokeStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Grid>
                            <Border x:Name="DateBorder" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                                    <DatePickerTextBox x:Name="PART_TextBox" Padding="11,0" Background="Transparent"
                                                       BorderThickness="0" Foreground="{TemplateBinding Foreground}"
                                                       VerticalContentAlignment="Center"/>
                                    <Button x:Name="PART_Button" Grid.Column="1" Width="34" Height="32" MinWidth="0"
                                            Margin="0,0,4,0" Padding="8" HorizontalAlignment="Right"
                                            VerticalAlignment="Center" Background="#EFF6FF"
                                            BorderBrush="Transparent" Focusable="False">
                                        <Viewbox>
                                            <Path Data="M3,5 H17 V18 H3 Z M6,2 V7 M14,2 V7 M3,9 H17"
                                                  Stroke="#2563EB" StrokeThickness="1.7"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        </Viewbox>
                                    </Button>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom" StaysOpen="False">
                                <Border Margin="0,6,0,0" Padding="8" Background="White"
                                        BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="10">
                                    <Border.Effect><DropShadowEffect BlurRadius="18" Opacity="0.15" ShadowDepth="4"/></Border.Effect>
                                    <Calendar x:Name="PART_Calendar" FontSize="14">
                                        <Calendar.LayoutTransform>
                                            <ScaleTransform ScaleX="1.18" ScaleY="1.18"/>
                                        </Calendar.LayoutTransform>
                                    </Calendar>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="DateBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="DateBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <ContentPresenter Margin="18,16,18,3" ContentSource="Header"
                                                  TextElement.Foreground="{StaticResource TextPrimaryBrush}"
                                                  TextElement.FontSize="16" TextElement.FontWeight="SemiBold"/>
                                <ContentPresenter Grid.Row="1" Margin="{TemplateBinding Padding}"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Border Grid.Row="0" Margin="0,0,0,14" Padding="5" HorizontalAlignment="Left"
                                    Background="#E8EDF5" CornerRadius="9">
                                <TabPanel IsItemsHost="True"/>
                            </Border>
                            <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Padding="{TemplateBinding Padding}" Background="Transparent" CornerRadius="6">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsSelected" Value="False"/></MultiTrigger.Conditions>
                                <Setter TargetName="TabBorder" Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#102A46">
            <Grid Margin="22,25,20,21">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Width="38" Height="38" Background="#2563EB" CornerRadius="10">
                        <Viewbox Margin="9">
                            <Path Data="M2,4 H18 V16 H2 Z M2,5 L10,11 L18,5"
                                  Stroke="White" StrokeThickness="1.8" StrokeLineJoin="Round"/>
                        </Viewbox>
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="ChronoMail" Foreground="White" FontSize="19" FontWeight="SemiBold"/>
                        <TextBlock Text="BRIDGE" Foreground="#7DD3FC" FontSize="10" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>
                <ScrollViewer Grid.Row="1" Margin="0,32,0,18" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="MIGRATION WORKFLOW" Margin="2,0,0,13" Foreground="#91A8BF"
                                   FontSize="10.5" FontWeight="Bold"/>
                        <TextBlock Text="01   IMAP source" Foreground="White" FontWeight="SemiBold" Padding="5,8"/>
                        <TextBlock Text="02   Google account" Foreground="White" FontWeight="SemiBold" Padding="5,8"/>
                        <TextBlock Text="03   Local archive" Foreground="White" FontWeight="SemiBold" Padding="5,8"/>
                        <TextBlock Text="04   Migration scope" Foreground="White" FontWeight="SemiBold" Padding="5,8"/>
                        <TextBlock Text="05   Safety scan" Foreground="White" FontWeight="SemiBold" Padding="5,8"/>
                        <TextBlock Text="06   Migration" Foreground="White" FontWeight="SemiBold" Padding="5,8"/>
                        <TextBlock Text="07   Review" Foreground="White" FontWeight="SemiBold" Padding="5,8"/>
                        <TextBlock Text="08   Report" Foreground="White" FontWeight="SemiBold" Padding="5,8"/>
                    </StackPanel>
                </ScrollViewer>
                <Border Grid.Row="2" Padding="13" Background="#193B58" CornerRadius="9">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Width="25" Height="25" Background="#28506F" CornerRadius="13">
                            <TextBlock Text="i" Foreground="#BAE6FD" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                        </Border>
                        <TextBlock Grid.Column="1" Margin="10,0,0,0"
                                   Text=".eml files are not encrypted. Use a BitLocker-protected drive."
                                   Foreground="#D9E7F1" FontSize="11.5" TextWrapping="Wrap"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="30,25,30,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Email migration" FontSize="27" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <Ellipse Width="7" Height="7" Margin="0,1,8,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource PrimaryBrush}"/>
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="HeaderPulse">
                                                    <Storyboard AutoReverse="True" RepeatBehavior="Forever">
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="1" To="0.35" Duration="0:0:0.65"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="HeaderPulse"/>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextSecondaryBrush}"
                                   MaxWidth="650" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Padding="14,10" VerticalAlignment="Center" Background="White"
                        BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="10">
                    <CheckBox Content="Simulation mode" IsChecked="{Binding SimulationMode}"
                              Style="{StaticResource ToggleSwitchStyle}"/>
                </Border>
            </Grid>

            <TabControl Grid.Row="1">
                <TabItem Header="Setup">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <GroupBox Header="Turbify / IMAP">
                                    <StackPanel>
                                        <TextBlock Text="Server"/>
                                        <TextBox Text="{Binding ImapHost}"/>
                                        <TextBlock Text="Port"/>
                                        <TextBox Text="{Binding ImapPort}"/>
                                        <TextBlock Text="Full email address"/>
                                        <TextBox Text="{Binding ImapUser}"/>
                                        <TextBlock Text="App password"/>
                                        <PasswordBox PasswordChanged="PasswordBox_OnPasswordChanged"/>
                                        <CheckBox Content="Remember with Windows protection"
                                                  IsChecked="{Binding RememberPassword}" Margin="0,0,0,8"/>
                                        <Button Content="Test IMAP connection"
                                                Command="{Binding TestImapCommand}" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </GroupBox>
                                <GroupBox Header="Google Workspace">
                                    <StackPanel>
                                        <TextBlock Text="Desktop OAuth client"/>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Browse…"
                                                    Command="{Binding SelectClientJsonCommand}"/>
                                            <TextBox Text="{Binding ClientJsonPath}" IsReadOnly="True"/>
                                        </DockPanel>
                                        <TextBlock Text="Label prefix"/>
                                        <TextBox Text="{Binding LabelPrefix}"/>
                                        <Button Content="Authorize Google" Command="{Binding AuthorizeGoogleCommand}"
                                                HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <GroupBox Header="Local archive">
                                    <StackPanel>
                                        <TextBlock Text="Root folder"/>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Browse…"
                                                    Command="{Binding SelectArchiveCommand}"/>
                                            <TextBox Text="{Binding ArchiveRoot}"/>
                                        </DockPanel>
                                        <TextBlock Text="The messages, state, logs, and reports folders will be created."
                                                   Foreground="#546E7A" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </GroupBox>
                                <GroupBox Header="Scope">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center" Text="Folders (comma-separated; blank = all)"/>
                                            <ToggleButton x:Name="FoldersHelpButton" Grid.Column="1" Content="?"
                                                          Style="{StaticResource HelpToggleButtonStyle}"
                                                          ToolTip="Show folder examples"
                                                          AutomationProperties.Name="Show IMAP folder examples"/>
                                            <Popup IsOpen="{Binding IsChecked, ElementName=FoldersHelpButton, Mode=TwoWay}"
                                                   Placement="Bottom" PlacementTarget="{Binding ElementName=FoldersHelpButton}"
                                                   HorizontalOffset="-8" VerticalOffset="5" StaysOpen="False"
                                                   AllowsTransparency="True" PopupAnimation="Fade">
                                                <Border Width="330" Padding="15" Background="White"
                                                        BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="10">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="20" Opacity="0.18" ShadowDepth="5"/>
                                                    </Border.Effect>
                                                    <StackPanel>
                                                        <TextBlock Text="IMAP folder names" FontSize="14" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   Text="Use the exact names from your account. Common examples are Inbox, Sent, Drafts, Archive, Spam, and Trash."/>
                                                        <Border Margin="0,10,0,0" Padding="10,7" Background="#F8FAFC" CornerRadius="6">
                                                            <TextBlock FontFamily="Consolas" Foreground="{StaticResource TextPrimaryBrush}"
                                                                       Text="Inbox,Sent,Archive"/>
                                                        </Border>
                                                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   Text="Separate multiple folders with commas, or leave the field blank to include all folders."/>
                                                    </StackPanel>
                                                </Border>
                                            </Popup>
                                        </Grid>
                                        <TextBox Text="{Binding SelectedFolders}"/>
                                        <TextBlock Text="Inclusive cutoff date (optional)"/>
                                        <DatePicker SelectedDate="{Binding MaximumDate}" Margin="0,4,0,10"/>
                                        <CheckBox Content="Prevent sleep during transfers"
                                                  IsChecked="{Binding PreventSleep}" Margin="0,0,0,8"/>
                                        <TextBlock Text="For safety, messages without a Message-ID are sent for review."
                                                   TextWrapping="Wrap" Foreground="#795548"/>
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Progress">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20">
                            <UniformGrid Columns="4" Margin="0,0,0,16">
                                <GroupBox Header="Discovered"><TextBlock Text="{Binding Progress.Discovered}" FontSize="24"/></GroupBox>
                                <GroupBox Header="Downloaded"><TextBlock Text="{Binding Progress.Downloaded}" FontSize="24"/></GroupBox>
                                <GroupBox Header="Imported"><TextBlock Text="{Binding Progress.Imported}" FontSize="24"/></GroupBox>
                                <GroupBox Header="Existing"><TextBlock Text="{Binding Progress.Existing}" FontSize="24"/></GroupBox>
                                <GroupBox Header="Skipped"><TextBlock Text="{Binding Progress.Skipped}" FontSize="24"/></GroupBox>
                                <GroupBox Header="Needs review"><TextBlock Text="{Binding Progress.NeedsReview}" FontSize="24"/></GroupBox>
                                <GroupBox Header="Failed"><TextBlock Text="{Binding Progress.Failed}" FontSize="24"/></GroupBox>
                                <GroupBox Header="Bytes"><TextBlock Text="{Binding Progress.BytesDownloaded, StringFormat=N0}" FontSize="20"/></GroupBox>
                            </UniformGrid>
                            <GroupBox Header="Activity">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Status"/><TextBlock Grid.Column="1" Text="{Binding Progress.RunState}"/>
                                    <TextBlock Grid.Row="1" Text="Folder"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Progress.CurrentFolder}"/>
                                    <TextBlock Grid.Row="2" Text="Speed"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Progress.BytesPerSecond, StringFormat={}{0:N0} bytes/s}"/>
                                    <TextBlock Grid.Row="3" Text="Last transfer"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Progress.LastTransferUtc}"/>
                                    <TextBlock Grid.Row="4" Text="Next attempt"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Progress.NextAttemptUtc}"/>
                                </Grid>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Review &amp; report">
                    <StackPanel Margin="20">
                        <TextBlock Text="The standard review only includes technical ID, folder, date, size, status, and code."
                                   TextWrapping="Wrap" FontSize="15" Margin="0,0,0,14"/>
                        <TextBlock Text="Subjects, senders, and content are never shown. Attachments are never opened automatically."
                                   TextWrapping="Wrap" Foreground="#546E7A" Margin="0,0,0,18"/>
                        <Button Content="Retry failed items" Command="{Binding RetryCommand}" HorizontalAlignment="Left"/>
                        <Button Content="Export report" Command="{Binding ExportCommand}" HorizontalAlignment="Left"/>
                    </StackPanel>
                </TabItem>
            </TabControl>

            <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                    Padding="10" Margin="0,14,0,0" CornerRadius="11">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Margin="5,0,5,8" Padding="11,7" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                            Background="#EFF6FF" CornerRadius="8"
                            Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="24" Height="24" Margin="0,0,10,0" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform><RotateTransform/></Grid.RenderTransform>
                                <Grid.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                 From="0" To="360" Duration="0:0:0.9"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Grid.Triggers>
                                <Ellipse Stroke="#BFDBFE" StrokeThickness="2"/>
                                <Path Data="M 12,2 A 10,10 0 0 1 22,12" Stroke="{StaticResource PrimaryBrush}"
                                      StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding ActivityTitle}" Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="12.5" FontWeight="SemiBold"/>
                                <ProgressBar Width="184" Height="3" Margin="0,5,0,0" IsIndeterminate="True"
                                             Foreground="{StaticResource PrimaryBrush}" Background="#DBEAFE"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Scan" Command="{Binding ScanCommand}"/>
                        <Button Command="{Binding StartCommand}" Style="{StaticResource PrimaryButtonStyle}" MinWidth="136">
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Start migration"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMigrationRunning}" Value="True">
                                                <Setter Property="Text" Value="Migrating&#x2026;"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                        <Button Content="Pause" Command="{Binding PauseCommand}"/>
                        <Button Content="Resume" Command="{Binding ResumeCommand}"/>
                        <Button Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource DangerButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Column="1" Panel.ZIndex="20" Width="420" Margin="0,0,30,94"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Padding="15"
                BorderThickness="1" CornerRadius="11">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" Opacity="0.16" ShadowDepth="7"/>
            </Border.Effect>
            <Border.RenderTransform><TranslateTransform X="24"/></Border.RenderTransform>
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="IsHitTestVisible" Value="False"/>
                    <Setter Property="Background" Value="#EFF6FF"/>
                    <Setter Property="BorderBrush" Value="#BFDBFE"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding NotificationKind}" Value="Success">
                            <Setter Property="Background" Value="#ECFDF5"/>
                            <Setter Property="BorderBrush" Value="#A7F3D0"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding NotificationKind}" Value="Warning">
                            <Setter Property="Background" Value="#FFFBEB"/>
                            <Setter Property="BorderBrush" Value="#FDE68A"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding NotificationKind}" Value="Error">
                            <Setter Property="Background" Value="#FEF2F2"/>
                            <Setter Property="BorderBrush" Value="#FECACA"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsNotificationVisible}" Value="True">
                            <Setter Property="IsHitTestVisible" Value="True"/>
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         To="0" Duration="0:0:0.25">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16"/>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         To="24" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="34" Height="34" Margin="0,0,12,0" VerticalAlignment="Top" CornerRadius="17">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#DBEAFE"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NotificationKind}" Value="Success">
                                    <Setter Property="Background" Value="#D1FAE5"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding NotificationKind}" Value="Warning">
                                    <Setter Property="Background" Value="#FEF3C7"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding NotificationKind}" Value="Error">
                                    <Setter Property="Background" Value="#FEE2E2"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17" FontWeight="Bold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="i"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NotificationKind}" Value="Success">
                                        <Setter Property="Text" Value="&#x2713;"/>
                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding NotificationKind}" Value="Warning">
                                        <Setter Property="Text" Value="!"/>
                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding NotificationKind}" Value="Error">
                                        <Setter Property="Text" Value="!"/>
                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
                <StackPanel Grid.Column="1" Margin="0,1,8,0">
                    <TextBlock Text="{Binding NotificationTitle}" Foreground="{StaticResource TextPrimaryBrush}"
                               FontWeight="SemiBold" FontSize="14.5"/>
                    <TextBlock Text="{Binding NotificationMessage}" Margin="0,4,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="2" Width="30" Height="30" MinWidth="0" Margin="0" Padding="8"
                        VerticalAlignment="Top" Background="Transparent" BorderBrush="Transparent"
                        Command="{Binding DismissNotificationCommand}" ToolTip="Dismiss notification">
                    <Path Data="M 2,2 L 10,10 M 10,2 L 2,10" Stroke="{StaticResource TextSecondaryBrush}"
                          StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
